# Claude Code self-observability -> Honeycomb (example)
#
# Copy to a location your shell sources, e.g. ~/.claude/claude-code-telemetry.zsh,
# then add "source ~/.claude/claude-code-telemetry.zsh" to ~/.zshrc AFTER the line
# that sets HONEYCOMB_API_KEY. Contains no secret: the key is referenced, never inlined.
#
# Docs: https://code.claude.com/docs/en/monitoring-usage
# Inspired by: https://www.honeycomb.io/blog/can-claude-code-observe-its-own-code

export HONEYCOMB_API_KEY

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1   # beta: emit spans, not just metrics/events

export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_TRACES_EXPORTER=otlp

export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io

# Signal routing (verified empirically against Honeycomb, 2026-09-12):
#   logs + traces -> dataset named by service.name, i.e. "claude-code"
#   metrics       -> the environment's shared "metrics" dataset, tagged service.name=claude-code
# The x-honeycomb-dataset header is ignored for every signal here (on the generic headers var
# and on OTEL_EXPORTER_OTLP_METRICS_HEADERS alike), so it is deliberately omitted.
# Filter metric queries on service.name = "claude-code" to separate them from other producers.
export OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=${HONEYCOMB_API_KEY}"

# Content capture. These ship raw text to Honeycomb -- see docs/SELF_OBSERVABILITY.md.
export OTEL_LOG_USER_PROMPTS=1
export OTEL_LOG_ASSISTANT_RESPONSES=1
export OTEL_LOG_TOOL_DETAILS=1
export OTEL_LOG_TOOL_CONTENT=1

export OTEL_METRICS_INCLUDE_VERSION=true
export OTEL_METRICS_INCLUDE_ENTRYPOINT=true
