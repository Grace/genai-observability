aws_region = "us-east-1"
project = "genai-observability"

# Required. The ALB fronts an unauthenticated endpoint that spends Bedrock tokens on
# every request, so ingress is restricted to these CIDRs. 0.0.0.0/0 is rejected by a
# variable validation rather than being allowed by accident.
# Find your address with: curl -s https://checkip.amazonaws.com
allowed_cidrs = ["203.0.113.4/32"]

# Use Bedrock Converse-compatible model IDs or inference profile IDs enabled for your account/region.
candidate_model_id = "amazon.nova-lite-v1:0"
oracle_model_id_a = "amazon.nova-lite-v1:0"
oracle_model_id_b = "amazon.nova-lite-v1:0"
replay_model_id = "amazon.nova-lite-v1:0"

# Create this secret with scripts/create-honeycomb-secret.sh; do not put the API key itself in tfvars.
honeycomb_api_key_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:genai-observability/honeycomb-..."
honeycomb_otlp_endpoint = "https://api.honeycomb.io"

mapping_model_id = "REPLACE_WITH_BEDROCK_MODEL_OR_INFERENCE_PROFILE"

# Optional: provide rates you have verified for the exact model IDs and region.
# Rates are USD per 1M tokens. Unknown models intentionally produce no cost value.
# tfvars cannot call functions, so this is a JSON string, not jsonencode():
# model_pricing_json = <<-JSON
#   {
#     "version": "2026-09-verified",
#     "currency": "USD",
#     "unit": "per_1m_tokens",
#     "models": {
#       "your.model.id": { "input": 0.00, "output": 0.00 }
#     }
#   }
# JSON

# Optional public hosting for the Normalization Inspector. Leave web_domain
# empty to skip all of it. DNS is managed wherever your domain lives; Terraform
# outputs the records to create.
# web_domain            = "inspector.example.com"
# api_domain            = "api.example.com"          # /ask, behind a Cognito login
# cognito_domain_prefix = "example-<account-id>"      # must be globally unique
# waf_rate_limit        = 500                         # requests per 5 min per IP

# Budget alerts: 80% forecast and 100% actual. Empty email disables the budget.
# budget_alert_email = "you@example.com"
# budget_limit_usd   = "100"
